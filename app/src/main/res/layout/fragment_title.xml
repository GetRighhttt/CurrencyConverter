<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motion_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    tools:context=".presentation.view.TitleFragment">

    <LinearLayout
        android:id="@+id/hero_stack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <TextView
            android:id="@+id/brand_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="@string/brand_label"
            android:textColor="@color/brand_yellow_deep"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="56dp"
            android:layout_height="6dp"
            android:layout_marginTop="20dp"
            android:background="@color/brand_yellow" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/currency_converter"
            android:textColor="@color/primary_text"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/an_easy_way_to_convert_currency"
            android:textColor="@color/secondary_text"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:minHeight="58dp"
            android:text="@string/begin"
            android:textAllCaps="false"
            android:textColor="@color/brand_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_yellow"
            app:cornerRadius="18dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
