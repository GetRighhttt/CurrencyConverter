<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CurrencyConverterApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_black</item>
        <item name="colorPrimaryVariant">@color/brand_black</item>
        <item name="colorOnPrimary">@color/brand_white</item>
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorSecondaryVariant">@color/brand_yellow_deep</item>
        <item name="colorOnSecondary">@color/brand_black</item>
        <item name="colorSurface">@color/screen_background</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="o_mr1">@color/outline</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

</resources>
